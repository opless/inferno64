TARGMODEL=	Posix
TARGSHTYPE=	sh
CPUS=		amd64

O=		o
OS=		o

AR=		ar
ARFLAGS=	ruvs

AS=		cc -arch x86_64 -c
ASFLAGS=

CC=		cc -arch x86_64 -c
CFLAGS=	-arch x86_64 -g\
		-O\
		-Wno-deprecated-declarations -Wuninitialized -Wunused -Wreturn-type -Wimplicit\
		-I$ROOT/MacOSX/amd64/include\
		-I$ROOT/include\
 		-I/usr/X11R6/include\
		-DOPENBSD_amd64 -fno-stack-protector\
		-fms-extensions -Wno-microsoft-anon-tag

ANSICPP=
LD=		cc -arch x86_64
LDFLAGS=	-L/usr/X11R6/lib

SYSLIBS=

YACC=		iyacc
YFLAGS=		-d
